generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FACULTY
  STUDENT
}

enum AttemptStatus {
  SUCCESS
  ERROR
  RUNNING
}

enum Language {
  C
  CPP
  JAVA
  PYTHON
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role
  createdAt     DateTime @default(now())

  roomsCreated  Room[]         @relation("FacultyRooms")
  memberships   RoomMember[]
  submissions   Submission[]
}

model Room {
  id          String       @id @default(uuid())
  code        String       @unique // short join code, e.g. "CS101-A3F9"
  title       String
  faculty     User         @relation("FacultyRooms", fields: [facultyId], references: [id])
  facultyId   String
  allowedHints Int         @default(3)
  createdAt   DateTime     @default(now())

  members     RoomMember[]
  problems    Problem[]
}

model RoomMember {
  id       String   @id @default(uuid())
  room     Room     @relation(fields: [roomId], references: [id])
  roomId   String
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  joinedAt DateTime @default(now())

  @@unique([roomId, userId])
}

model Problem {
  id          String   @id @default(uuid())
  room        Room     @relation(fields: [roomId], references: [id])
  roomId      String
  title       String
  description String
  starterCode String
  language    Language @default(C)
  createdAt   DateTime @default(now())

  submissions Submission[]
}

// One submission = one "run" click by a student on a problem.
// It can go through multiple attempts (recompiles after edits).
model Submission {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  problem    Problem  @relation(fields: [problemId], references: [id])
  problemId  String
  code       String
  status     AttemptStatus
  createdAt  DateTime @default(now())

  attempts    Attempt[]
}

model Attempt {
  id              String   @id @default(uuid())
  submission      Submission @relation(fields: [submissionId], references: [id])
  submissionId    String
  compilerRawJson String     // raw gcc/clang -fdiagnostics-format=json output
  errorCategory   String?    // syntax | type-mismatch | undeclared | linker | segfault | runtime | none
  explanation     String?    // AI-generated plain-language explanation
  resolved        Boolean    @default(false)
  createdAt       DateTime   @default(now())

  hintUsages  HintUsage[]
  aiPatch     AiPatch?
}

model HintUsage {
  id        String   @id @default(uuid())
  attempt   Attempt  @relation(fields: [attemptId], references: [id])
  attemptId String
  level     Int      // 1, 2, 3
  content   String
  createdAt DateTime @default(now())
}

model AiPatch {
  id         String   @id @default(uuid())
  attempt    Attempt  @relation(fields: [attemptId], references: [id])
  attemptId  String   @unique
  patchDiff  String
  reasoning  String
  createdAt  DateTime @default(now())
}
